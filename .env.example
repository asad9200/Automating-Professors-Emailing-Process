# LLM: groq (free tier) or anthropic
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Search: auto uses Tavily if TAVILY_API_KEY is set, otherwise free DuckDuckGo
SEARCH_PROVIDER=auto
TAVILY_API_KEY=
# Optional research providers
SERPAPI_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_API_KEY=
# Optional contact address for the OpenAlex polite pool
OPENALEX_MAILTO=
DATABASE_URL=sqlite:///emailering.db
CHECKPOINT_DB_PATH=emailering_checkpoints.db
LOG_LEVEL=INFO
SCRAPE_DELAY_SECONDS=1.0
SCRAPE_MAX_PAGES=100
USER_AGENT=Emailering/0.1 (academic faculty discovery)
# Open pages that refuse plain HTTP in a regular browser window (needs `uv run playwright install chromium`)
BROWSER_FALLBACK=true
BROWSER_HEADLESS=false
RESEARCH_MAX_PAPERS=8
RESEARCH_CACHE_DAYS=30
# Gmail OAuth desktop client file and the token it writes (both git-ignored)
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json
# Optional local CV file to attach; you can also upload one in the Review page
CV_ATTACHMENT_PATH=
SEND_MAX_PER_DAY=20
SEND_MIN_GAP_SECONDS=120
SEND_MAX_GAP_SECONDS=300
FOLLOWUP_AFTER_DAYS=10
